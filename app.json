{
  "expo": {
    "name": "Tantra",
    "slug": "tantraone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "tantra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0918"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tantra.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0918"
      },
      "package": "com.tantra.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0918",
          "image": "./src/assets/images/splash.png",
          "imageWidth": 220
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tantra to access your photos so you can add them to your listings.",
          "cameraPermission": "Allow Tantra to use your camera to take photos of your products."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tantra to use your camera to take photos and scan codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tantra to use your location to set your listing and delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D28D9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "extra": {
      "apiBaseUrl": "https://automaker-passion-unworried.ngrok-free.dev/api/v1",
      "apiTimeoutMs": 45000,
      "environment": "development",
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "9147f3fe-dcc9-44fb-9aa2-8b44b72c9e6a"
      }
    }
  }
}
